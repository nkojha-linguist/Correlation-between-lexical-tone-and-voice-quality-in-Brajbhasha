# --- 4. CONTOUR PLOT & GRANULAR STATS FUNCTION (WITH LRT, EFFECT SIZE, AND FDR) ---
create_contour_plot <- function(measure_name, data_input) {
  
  pretty_name <- label_map[measure_name]
  measure_data <- data_input %>% filter(Measure == measure_name)
  significance_results <- data.frame()
  
  for (dataset in unique(measure_data$Dataset)) {
    for (time_pt in 1:9) {
      time_data <- measure_data %>% 
        filter(Dataset == dataset, Timepoint == time_pt)
      
      if (nrow(time_data) > 0 && length(unique(time_data$Tone)) == 2) {
        tryCatch({
          # Fit full model (with Tone) and null model (without Tone)
          model <- lmer(Value ~ Tone + (1 | Subject), data = time_data, REML = FALSE)
          null_model <- lmer(Value ~ 1 + (1 | Subject), data = time_data, REML = FALSE)
          
          # Model summary
          model_summary <- summary(model)
          tone_pvalue <- model_summary$coefficients[2, 5]
          tone_tvalue <- model_summary$coefficients[2, 4]
          tone_estimate <- model_summary$coefficients[2, 1]
          tone_se <- model_summary$coefficients[2, 2]
          
          # Likelihood Ratio Test
          lrt_result <- anova(null_model, model)
          lrt_chisq <- lrt_result[["Chisq"]][2]
          lrt_df <- lrt_result[["Df"]][2] - lrt_result[["Df"]][1]
          lrt_pvalue <- lrt_result[["Pr(>Chisq)"]][2]
          
          # Calculate effect size (semi-partial R² for Tone)
          effect_size <- NA
          tryCatch({
            r2_result <- r2beta(model, method = 'kr', partial = TRUE)
            effect_size <- r2_result[r2_result$Effect == "Tone", "Rsq"]
            if (length(effect_size) == 0) effect_size <- NA
          }, error = function(e) {
            # If r2beta fails, compute Cohen's f approximation
            f2 <- (tone_tvalue^2) / (tone_tvalue^2 + nrow(time_data) - 2)
            effect_size <- f2 / (1 + f2)
          })
          
          # Calculate marginal R² for the full model
          marginal_r2 <- NA
          tryCatch({
            if (require(performance)) {
              marginal_r2 <- performance::r2_nakagawa(model, by_group = FALSE)$R2_marginal
            }
          }, error = function(e) {})
          
          low_mean <- mean(time_data$Value[time_data$Tone == "Low"], na.rm = TRUE)
          neutral_mean <- mean(time_data$Value[time_data$Tone == "Neutral"], na.rm = TRUE)
          diff_val <- low_mean - neutral_mean
          
          sig_result <- data.frame(
            Dataset = dataset, 
            Timepoint = time_pt, 
            Tone_Estimate = tone_estimate,
            Tone_SE = tone_se,
            Tone_tvalue = tone_tvalue,
            p_value = tone_pvalue,
            LRT_Chisq = lrt_chisq,
            LRT_df = lrt_df,
            LRT_p_value = lrt_pvalue,
            Effect_Size_R2 = effect_size,
            Marginal_R2 = marginal_r2,
            Low_Mean = low_mean, 
            Neutral_Mean = neutral_mean,
            Difference_Low_Minus_Neutral = diff_val,
            stringsAsFactors = FALSE
          )
          significance_results <- bind_rows(significance_results, sig_result)
        }, error = function(e) {
          cat("Model failed for", measure_name, "Dataset:", dataset, "Point:", time_pt, "\n")
          cat("Error:", e$message, "\n")
        })
      }
    }
  }
  
  # Apply FDR correction separately for each dataset within the measure
  # This controls false discovery rate across the 9 time points for each dataset
  if (nrow(significance_results) > 0) {
    significance_results <- significance_results %>%
      group_by(Dataset) %>%
      mutate(
        p_value_FDR = p.adjust(p_value, method = "fdr"),
        LRT_p_value_FDR = p.adjust(LRT_p_value, method = "fdr")
      ) %>%
      ungroup() %>%
      mutate(
        Significance = case_when(
          p_value < 0.001 ~ "***", 
          p_value < 0.01 ~ "**", 
          p_value < 0.05 ~ "*", 
          p_value < 0.1 ~ ".", 
          TRUE ~ "ns"
        ),
        FDR_Significance = case_when(
          p_value_FDR < 0.001 ~ "***",
          p_value_FDR < 0.01 ~ "**",
          p_value_FDR < 0.05 ~ "*",
          p_value_FDR < 0.1 ~ ".",
          TRUE ~ "ns"
        ),
        LRT_Significance = case_when(
          LRT_p_value < 0.001 ~ "***", 
          LRT_p_value < 0.01 ~ "**", 
          LRT_p_value < 0.05 ~ "*", 
          LRT_p_value < 0.1 ~ ".", 
          TRUE ~ "ns"
        ),
        LRT_FDR_Significance = case_when(
          LRT_p_value_FDR < 0.001 ~ "***",
          LRT_p_value_FDR < 0.01 ~ "**",
          LRT_p_value_FDR < 0.05 ~ "*",
          LRT_p_value_FDR < 0.1 ~ ".",
          TRUE ~ "ns"
        ),
        Shape = case_when(
          p_value_FDR < 0.001 ~ 24,        # Using FDR-corrected values for plotting
          p_value_FDR < 0.01 ~ 23,
          p_value_FDR < 0.05 ~ 22,
          p_value_FDR < 0.1 ~ 21,
          TRUE ~ NA_real_
        ),
        Size = case_when(
          p_value_FDR < 0.001 ~ 3,
          p_value_FDR < 0.01 ~ 2.8,
          p_value_FDR < 0.05 ~ 2.2,
          p_value_FDR < 0.1 ~ 2,
          TRUE ~ NA_real_
        ),
        Symbol_Position = Low_Mean + 0.1 * abs(Low_Mean)
      )
  }
  
  # Plotting (using FDR-corrected significance markers)
  sig_symbols <- significance_results %>% filter(p_value_FDR < 0.1)
  plot_summary <- measure_data %>%
    group_by(Dataset, Timepoint, Tone) %>%
    summarise(Mean_Value = mean(Value, na.rm = TRUE), 
              SE = sd(Value, na.rm = TRUE) / sqrt(n()), 
              .groups = "drop")
  
  p <- ggplot(plot_summary, aes(x = Timepoint, y = Mean_Value, color = Tone, group = Tone)) +
    geom_line(linewidth = 1) +
    geom_point(size = 2) +
    geom_errorbar(aes(ymin = Mean_Value - SE, ymax = Mean_Value + SE), width = 0.3, alpha = 0.7) +
    geom_point(data = sig_symbols, aes(x = Timepoint, y = Symbol_Position), 
               shape = sig_symbols$Shape, size = sig_symbols$Size, 
               color = "black", fill = "black", show.legend = FALSE, inherit.aes = FALSE) +
    facet_wrap(~ Dataset, scales = "free_y", ncol = 4) +
    scale_x_continuous(breaks = 1:9, labels = paste0("p", 1:9)) +
    scale_color_manual(values = c("Neutral" = "red", "Low" = "turquoise3")) +
    labs(title = paste("Contour Analysis:", pretty_name), 
         x = "Time Point", y = paste(pretty_name, "Value"), color = "Tone",
         caption = "Significance markers based on FDR-corrected p-values") +
    theme_minimal(base_size = 12) +
    theme(plot.title = element_text(hjust = 0.5, face = "bold"), 
          legend.position = "top",
          plot.caption = element_text(hjust = 0.5, size = 8, color = "gray40"))
  
  final_plot <- plot_grid(p, 
                          ggdraw() + draw_label("Significance (FDR-corrected): ▲p<0.001 ◆p<0.01 ■p<0.05 ●p<0.1", 
                                                size = 12, color = "gray40"), 
                          ncol = 1, rel_heights = c(10, 1))
  
  print(final_plot)
  ggsave(paste0("Contour_Plot_", measure_name, "_FDR.png"), final_plot, width = 14, height = 10, dpi = 300)
  
  return(significance_results)
}

