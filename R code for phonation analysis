# Function to extract Tone effect from a model with LRT and effect size
extract_tone_effect <- function(model, null_model, dataset_name, dependent_var) {
  fe <- summary(model)$coefficients
  # Extract the ToneLow row (Since 'Neutral' is the reference)
  tone_row <- fe[grepl("ToneLow", rownames(fe)), ]
  
  # Perform LRT
  lrt_result <- anova(null_model, model)
  lrt_pvalue <- lrt_result[["Pr(>Chisq)"]][2]
  lrt_chisq <- lrt_result[["Chisq"]][2]
  lrt_df <- lrt_result[["Df"]][2] - lrt_result[["Df"]][1]
  
  # Calculate effect size (semi-partial R² using r2glmm)
  effect_size <- NA
  tryCatch({
    r2_result <- r2beta(model, method = 'kr', partial = TRUE)
    effect_size <- r2_result[r2_result$Effect == "Tone", "Rsq"]
    if (length(effect_size) == 0) effect_size <- NA
  }, error = function(e) {
    effect_size <- NA
  })
  
  # Also compute marginal R² for the model
  r2_marginal <- NA
  tryCatch({
    r2_marginal <- performance::r2_nakagawa(model, by_group = FALSE)$R2_marginal
  }, error = function(e) {
    r2_marginal <- NA
  })
  
  data.frame(
    Dataset = dataset_name,
    DV = dependent_var,
    Estimate = ifelse(length(tone_row) > 0, tone_row[1], NA),           # Coefficient for ToneLow
    Std_Error = ifelse(length(tone_row) > 1, tone_row[2], NA),          # Standard error
    df = ifelse(length(tone_row) > 2, tone_row[3], NA),                 # Degrees of freedom
    t_value = ifelse(length(tone_row) > 3, tone_row[4], NA),            # t-value
    p_value = ifelse(length(tone_row) > 4, tone_row[5], NA),            # p-value
    LRT_Chisq = lrt_chisq,            # LRT Chi-square
    LRT_df = lrt_df,                  # LRT degrees of freedom
    LRT_p_value = lrt_pvalue,         # LRT p-value
    Effect_Size_R2 = effect_size,     # Semi-partial R² for Tone
    Marginal_R2 = r2_marginal,        # Marginal R² for full model
    Significance = ifelse(length(tone_row) > 4,
                          case_when(
                            tone_row[5] < 0.001 ~ "***",
                            tone_row[5] < 0.01 ~ "**",
                            tone_row[5] < 0.05 ~ "*",
                            tone_row[5] < 0.1 ~ ".",
                            TRUE ~ "ns"
                          ), NA)
  )
}

# Run F0 and Duration models across all datasets
pre_hoc_detailed <- bind_rows(
  # F0 Models
  data %>% split(.$Dataset) %>% map_dfr(~ {
    model <- lmer(F0 ~ Tone + (1|Subject), data = .x, REML = FALSE)
    null_model <- lmer(F0 ~ 1 + (1|Subject), data = .x, REML = FALSE)
    extract_tone_effect(model, null_model, unique(.x$Dataset), "F0")
  }),
  # Duration Models
  data %>% split(.$Dataset) %>% map_dfr(~ {
    model <- lmer(Duration ~ Tone + (1|Subject), data = .x, REML = FALSE)
    null_model <- lmer(Duration ~ 1 + (1|Subject), data = .x, REML = FALSE)
    extract_tone_effect(model, null_model, unique(.x$Dataset), "Duration")
  })
)

# Apply FDR correction for pre-hoc analysis (across all tests)
